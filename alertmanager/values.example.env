# Copie para values.env (gitignored) e preencha. NUNCA commite o values.env.
#
# Este arquivo NAO passa pelo shell: quem le e' o render-config.py, literalmente.
# Senha com ' " # $ : espaco funciona, sem escape nenhum.
# Valor entre quotes vale exatamente o que esta' dentro, inclusive espaco no fim.
# Valor sem quotes e' aparado nas pontas.
#
# O smtp_hello NAO vem daqui: o script deriva do cluster logado (oc whoami --show-server).
# E' o campo que nao pode repetir entre clusters, porque relay valida HELO.
SMTP_SMARTHOST=smtp.example.com:25
SMTP_FROM=ALERTAS@example.com
SMTP_USER=usuario
SMTP_PASS=senha
# Endereco de email do canal do Teams. Quem tem isso posta no canal: trate como segredo.
TEAMS_TO=1234abcd.example.com@br.teams.ms
