{{/*
  RESTYLE do template padrao de email do Alertmanager.

  Regra deste arquivo: NAO mudar o que a mensagem diz, so' como ela aparece.
  A estrutura do email.default.html e' preservada na integra:
    "N alerts for <group labels>" -> "View in Alertmanager" -> "[N] Firing"
    -> Labels (todos) -> Annotations (todas) -> "Source" -> "Sent by Alertmanager"
  Mesmos textos, mesmos links, mesma ordem. Nenhum campo novo, nenhum removido.

  O que muda e' so' a identidade visual, herdada do relatorio de DCs/GC
  para o canal do Teams ficar consistente:
    #2C5F8A  azul (barra de titulo e cabecalho de secao; era laranja #e6522c)
    #D64545  vermelho de Firing
    #3F8F5F  verde de Resolved
    #1a1a1a  texto     #6b6b6b  rodape 11px
    Segoe UI, Arial, sans-serif / 13px

  border="1" e' ATRIBUTO HTML de proposito: o Teams descarta muito CSS mas
  honra o atributo, e' o que garante borda visivel la'.
*/}}

{{ define "teams.html" -}}
<html>
<body style="margin:0; padding:0; background-color:#f5f5f5; font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#1a1a1a;">
<table border="0" cellpadding="0" cellspacing="0" style="width:100%; background-color:#f5f5f5;">
<tr><td align="center" style="padding:12px;">
<table border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:820px; background-color:#ffffff; border:1px solid #d0d0d0;">

<tr>
<td style="background-color:#2C5F8A; color:#ffffff; padding:10px 14px; font-size:15px; font-weight:bold;">
{{ .Alerts | len }} alert{{ if gt (len .Alerts) 1 }}s{{ end }} for {{ range .GroupLabels.SortedPairs }}{{ .Name }}={{ .Value }} {{ end }}
</td>
</tr>

{{ if or .CommonLabels.cluster_banner .CommonLabels.managed_cluster }}
<tr>
<td style="background-color:#eaf1f7; color:#1a1a1a; padding:7px 14px; border-bottom:1px solid #d0d0d0; font-size:13px;">
<b>Originado em:</b> {{ if .CommonLabels.cluster_banner }}{{ .CommonLabels.cluster_banner }}{{ else }}{{ .CommonLabels.managed_cluster }}{{ end }}{{ if and .CommonLabels.cluster_banner .CommonLabels.managed_cluster }} <span style="color:#6b6b6b; font-size:11px;">({{ .CommonLabels.managed_cluster }})</span>{{ end }}
</td>
</tr>
{{ end }}

<tr>
<td style="padding:10px 14px; border-bottom:1px solid #e0e0e0;">
<a href="{{ .ExternalURL }}" style="color:#2C5F8A;">View in Alertmanager</a>
</td>
</tr>

{{ if gt (len .Alerts.Firing) 0 }}
<tr><td style="padding:12px 14px 6px 14px; font-weight:bold; color:#D64545;">[{{ .Alerts.Firing | len }}] Firing</td></tr>
{{ range .Alerts.Firing }}
<tr><td style="padding:0 14px 14px 14px;">
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse; width:100%; background-color:#ffffff;">
<tr style="background-color:#2C5F8A;"><th colspan="2" style="color:#ffffff; padding:6px; text-align:left;">Labels</th></tr>
{{ range .Labels.SortedPairs }}
{{ if or (eq .Name "cluster_banner") (eq .Name "managed_cluster") }}
<tr style="background-color:#eaf1f7;"><td style="color:#1a1a1a; padding:5px; width:200px;"><b>{{ .Name }}</b></td><td style="color:#1a1a1a; padding:5px;"><b>{{ .Value }}</b></td></tr>
{{ else }}
<tr><td style="color:#1a1a1a; padding:5px; width:200px;">{{ .Name }}</td><td style="color:#1a1a1a; padding:5px;">{{ .Value }}</td></tr>
{{ end }}
{{ end }}
{{ if gt (len .Annotations) 0 }}
<tr style="background-color:#2C5F8A;"><th colspan="2" style="color:#ffffff; padding:6px; text-align:left;">Annotations</th></tr>
{{ range .Annotations.SortedPairs }}
<tr><td style="color:#1a1a1a; padding:5px; width:200px;">{{ .Name }}</td><td style="color:#1a1a1a; padding:5px;">{{ .Value }}</td></tr>
{{ end }}
{{ end }}
</table>
<div style="padding-top:6px;"><a href="{{ .GeneratorURL }}" style="color:#2C5F8A;">Source</a></div>
</td></tr>
{{ end }}
{{ end }}

{{ if gt (len .Alerts.Resolved) 0 }}
<tr><td style="padding:12px 14px 6px 14px; font-weight:bold; color:#3F8F5F;">[{{ .Alerts.Resolved | len }}] Resolved</td></tr>
{{ range .Alerts.Resolved }}
<tr><td style="padding:0 14px 14px 14px;">
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse; width:100%; background-color:#ffffff;">
<tr style="background-color:#3F8F5F;"><th colspan="2" style="color:#ffffff; padding:6px; text-align:left;">Labels</th></tr>
{{ range .Labels.SortedPairs }}
{{ if or (eq .Name "cluster_banner") (eq .Name "managed_cluster") }}
<tr style="background-color:#eaf1f7;"><td style="color:#1a1a1a; padding:5px; width:200px;"><b>{{ .Name }}</b></td><td style="color:#1a1a1a; padding:5px;"><b>{{ .Value }}</b></td></tr>
{{ else }}
<tr><td style="color:#1a1a1a; padding:5px; width:200px;">{{ .Name }}</td><td style="color:#1a1a1a; padding:5px;">{{ .Value }}</td></tr>
{{ end }}
{{ end }}
{{ if gt (len .Annotations) 0 }}
<tr style="background-color:#3F8F5F;"><th colspan="2" style="color:#ffffff; padding:6px; text-align:left;">Annotations</th></tr>
{{ range .Annotations.SortedPairs }}
<tr><td style="color:#1a1a1a; padding:5px; width:200px;">{{ .Name }}</td><td style="color:#1a1a1a; padding:5px;">{{ .Value }}</td></tr>
{{ end }}
{{ end }}
</table>
<div style="padding-top:6px;"><a href="{{ .GeneratorURL }}" style="color:#3F8F5F;">Source</a></div>
</td></tr>
{{ end }}
{{ end }}

<tr><td style="padding:10px 14px; border-top:1px solid #e0e0e0; color:#6b6b6b; font-size:11px;">Sent by Alertmanager</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
{{- end }}
